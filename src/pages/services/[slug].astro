---
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import QuoteBand from '../../components/QuoteBand.astro';
import Base from '../../layouts/Base.astro';
import { areas } from '../../data/areas';
import { photos } from '../../data/photos';
import { breadcrumbLd, serviceLd } from '../../data/schema';
import { getService, services } from '../../data/services';

export function getStaticPaths() {
  return services.map((service) => ({ params: { slug: service.slug } }));
}

const { slug } = Astro.params;
const service = getService(slug || '');
if (!service) {
  throw new Error(`Missing service: ${slug}`);
}
const photo = photos[service.image];
const related = service.related.map((item) => getService(item)).filter((item) => item !== undefined);
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Services', path: '/services' },
  { name: service.title, path: `/services/${service.slug}` },
];
const local = areas.slice(0, 6);
---

<Base
  title={service.metaTitle}
  description={service.metaDescription}
  extraLd={[breadcrumbLd(crumbs), serviceLd(service)]}
>
  <section class="section page-hero">
    <div class="wrap">
      <Breadcrumbs items={crumbs.map((item, i) => ({ name: item.name, href: i === crumbs.length - 1 ? undefined : item.path }))} />
      <h1>{service.title}</h1>
      <p class="lede">{service.lede}</p>
    </div>
  </section>
  <section class="section" style="padding-top: 0;">
    <div class="wrap split">
      <img src={photo.src} width={photo.w} height={photo.h} alt={photo.alt} />
      <div class="prose">
        {service.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        {service.sections?.map((section) => (
          <>
            <h2>{section.heading}</h2>
            <p>{section.text}</p>
          </>
        ))}
        <h2>What is included</h2>
        <ul class="includes">
          {service.includes.map((item) => <li>{item}</li>)}
        </ul>
        <p>Adam will look at this on a free survey. Call 01234 900 002 or <a href="/contact">send the form</a>.</p>
      </div>
    </div>
  </section>
  <section class="section" style="padding-top: 0;">
    <div class="wrap">
      <h2>Related services</h2>
      <div class="card-grid" style="margin-top: 16px;">
        {related.map((item) => (
          <a class="card" href={`/services/${item.slug}`}>
            <h3>{item.title}</h3>
            <p>{item.summary}</p>
          </a>
        ))}
      </div>
      <h2 style="margin-top: 36px;">Where this work is booked</h2>
      <div class="area-grid" style="margin-top: 16px;">
        {local.map((area) => (
          <a class="area-card" href={`/areas/${area.slug}`}>
            <h3>{area.name}</h3>
            <p>{area.line}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
  <QuoteBand title={`Book a survey for ${service.title.toLowerCase()}.`} />
</Base>
