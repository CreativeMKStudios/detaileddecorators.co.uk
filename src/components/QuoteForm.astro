---
import { areas } from '../data/areas';
import { services } from '../data/services';
---

<form id="quote-form" class="form" method="post" action="mailto:info@detaileddecorators.co.uk">
  <p class="honeypot">
    <label>Company <input name="company" tabindex="-1" autocomplete="off" /></label>
  </p>
  <label>Name
    <input name="name" autocomplete="name" required />
  </label>
  <label>Phone
    <input name="phone" type="tel" autocomplete="tel" required />
  </label>
  <label>Email
    <input name="email" type="email" autocomplete="email" />
  </label>
  <label>Town
    <select name="town">
      <option value="">Choose a town</option>
      {areas.map((area) => <option value={area.name}>{area.name}</option>)}
      <option value="Somewhere else">Somewhere else</option>
    </select>
  </label>
  <label>What do you need?
    <select name="service">
      <option value="">Choose a service</option>
      {services.map((service) => <option value={service.title}>{service.title}</option>)}
      <option value="Not sure yet">Not sure yet</option>
    </select>
  </label>
  <label>About the job
    <textarea name="message" required placeholder="Rooms, rough timing, and anything we should know."></textarea>
  </label>
  <button class="btn" type="submit">Send to the team</button>
  <p id="form-status" class="form-status" role="status"></p>
  <p class="lede">This opens an email on your device. It is not stored on the website. See the <a href="/privacy">privacy note</a>.</p>
</form>
